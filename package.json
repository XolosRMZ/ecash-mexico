{
  "name": "ecash-mexico",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "build:js": "esbuild src/identidad/identidad.js --bundle --minify --outfile=assets/js/identidad.bundle.js --define:global=window",
    "build:sitemap": "node ./scripts/generate-sitemap.mjs",
    "build": "npm run build:css && npm run build:js && npm run build:sitemap",
    "lint:html": "htmlhint \"./**/*.html\" --config .htmlhintrc",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,yml,md}\"",
    "test:seo": "node ./scripts/validate-seo.mjs",
    "lint": "npm run lint:html && npm run format:check && npm run test:seo",
    "serve": "npx http-server -p 8080 -c-1",
    "lighthouse": "lhci autorun --config=./lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "esbuild": "^0.28.0",
    "glob": "^11.0.0",
    "htmlhint": "^1.6.3",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/universal-provider": "^2.23.9",
    "@xolosarmy/tonalli-core": "github:xolosArmy/tonalli-core#33dde8d",
    "buffer": "^6.0.3",
    "chronik-client": "^4.3.0"
  }
}
